<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree/"
     xml:base="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:FamilyTree="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree">
        <rdfs:comment xml:lang="en">This is an antology about family tree</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->

    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasAunt -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasAunt">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasParent"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasSister"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasBrother -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasBrother">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasSibling"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasSister"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasChild -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasChild">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasParent"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasSpouse"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasChild"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasCousin -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasCousin">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasParent"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasSibling"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasChild"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasDaughter -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasDaughter">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasChild"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasFather -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasFather">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasParent"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasFatherInLaw -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasFatherInLaw">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasParentInLaw"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasSpouse"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasFather"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasGrandFather -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasGrandFather">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasGrandParent"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasParent"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasFather"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasGrandMother -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasGrandMother">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasGrandParent"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasParent"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasMother"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasGrandParent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasGrandParent">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasParent"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasParent"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasHusband -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasHusband">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasSpouse"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasWife"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasMother -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasMother">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasParent"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasMotherInLaw -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasMotherInLaw">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasParentInLaw"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasSpouse"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasMother"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasNephew -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasNephew"/>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasNiece -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasNiece"/>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasOlderBrother -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasOlderBrother">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasBrother"/>
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasSibling"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasOlderSister -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasOlderSister">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasSibling"/>
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasSister"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasParent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasParent"/>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasParentInLaw -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasParentInLaw">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasSpouse"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasParent"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasSibling -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasSibling">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasSister -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasSister">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasSibling"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasSon -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasSon">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasChild"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasSpouse -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasSpouse">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasUncle -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasUncle">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasParent"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasBrother"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasWife -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasWife">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasSpouse"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasYoungerBrother -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasYoungerBrother">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasBrother"/>
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasSibling"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasYoungerSister -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasYoungerSister">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasSibling"/>
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasSister"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasAge -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasAge">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasDOB -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasDOB">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasDOD -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasDOD">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasFirstName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasFirstName">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasLastName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasLastName">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasMarriageName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasMarriageName">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasSex -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasSex">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#Deceased -->

    <owl:Class rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#Deceased">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#Person"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasDOD"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#Person"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#Person"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasDOD"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasDOD"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#Man -->

    <owl:Class rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#Man">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#Person"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasSex"/>
                        <owl:hasValue>Pria</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#Person"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#Person"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasSex"/>
                        <owl:hasValue>Pria</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasSex"/>
                <owl:hasValue>Pria</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#Parent -->

    <owl:Class rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#Parent">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#Person"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasChild"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#Person"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#Person"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#Person"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasChild"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#Person"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#hasChild"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/karla/ontologies/2025/10/FamilyTree#Person"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


