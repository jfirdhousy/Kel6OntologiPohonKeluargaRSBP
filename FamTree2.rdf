    <!-- http://www.semanticweb.org/lenovo/ontologies/2025/10/untitled-ontology-32/Deceased -->

    <owl:Class rdf:about="http://www.semanticweb.org/lenovo/ontologies/2025/10/untitled-ontology-32/Deceased">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lenovo/ontologies/2025/10/untitled-ontology-32/hasDOD"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lenovo/ontologies/2025/10/untitled-ontology-32/Person"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lenovo/ontologies/2025/10/untitled-ontology-32/Man -->

    <owl:Class rdf:about="http://www.semanticweb.org/lenovo/ontologies/2025/10/untitled-ontology-32/Man">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lenovo/ontologies/2025/10/untitled-ontology-32/Person"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/lenovo/ontologies/2025/10/untitled-ontology-32/Woman"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lenovo/ontologies/2025/10/untitled-ontology-32/Parent -->

    <owl:Class rdf:about="http://www.semanticweb.org/lenovo/ontologies/2025/10/untitled-ontology-32/Parent">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lenovo/ontologies/2025/10/untitled-ontology-32/hasChild"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/lenovo/ontologies/2025/10/untitled-ontology-32/Person"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lenovo/ontologies/2025/10/untitled-ontology-32/Person"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lenovo/ontologies/2025/10/untitled-ontology-32/Person -->

